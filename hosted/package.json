{
  "name": "save2ship-hosted",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=10 <12" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "capacity": "npm run build && node tests/capacity/run.mjs",
    "dryrun": "wrangler deploy --dry-run --outdir .local/dryrun",
    "probe:dryrun": "wrangler deploy --config wrangler.probe.jsonc --dry-run --outdir .local/probe-dryrun",
    "dev": "wrangler dev --ip 127.0.0.1"
  },
  "dependencies": { "jose": "6.2.15" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261104.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
