{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "save2ship-beta",
  "main": "src/app.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./.local/client-assets", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "HOSTED_ENABLED": "false", "ADMISSION_OPEN": "false", "ADMISSION_UIDS": "[]", "PROCESSING_OPEN": "false", "BETA_CAP": "0",
    "FIREBASE_PROJECT_ID": "", "FIREBASE_PUBLIC_CONFIG": "{}", "OPERATOR_UIDS": "[]"
  },
  "durable_objects": { "bindings": [
    { "name": "WORKSPACES", "class_name": "Workspace" },
    { "name": "REGISTRY", "class_name": "Registry" }
  ] },
  "migrations": [{ "tag": "app-v1", "new_sqlite_classes": ["Workspace", "Registry"] }],
  "observability": { "enabled": false }
}
