{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "save2ship-beta",
  "main": "src/app.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./.local/client-assets", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "HOSTED_ENABLED": "false", "ADMISSION_OPEN": "false", "ADMISSION_UIDS": "[]", "PROCESSING_OPEN": "false", "BETA_CAP": "0",
    "FIREBASE_PROJECT_ID": "", "FIREBASE_PUBLIC_CONFIG": "{}", "OPERATOR_UIDS": "[]",
    "FIRESTORE_ENABLED": "true", "FIRESTORE_DATABASE_ID": "save2ship",
    "ENTITLEMENTS_ENABLED": "true", "BILLING_ENABLED": "false", "RAZORPAY_MODE": "test"
  },
  "durable_objects": { "bindings": [
    { "name": "WORKSPACES", "class_name": "FirebaseWorkspace" },
    { "name": "REGISTRY", "class_name": "FirebaseRegistry" }
  ] },
  "migrations": [
    { "tag": "app-v1", "new_sqlite_classes": ["Workspace", "Registry"] },
    { "tag": "app-firebase-v1", "new_sqlite_classes": ["FirebaseWorkspace", "FirebaseRegistry"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
