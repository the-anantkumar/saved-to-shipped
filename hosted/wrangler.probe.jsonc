{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "save2ship-p1-probe",
  "main": "probe/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PROBE_EXPIRES_AT": "1970-01-01T00:00:00Z",
    "PROBE_INCLUDE_FTS": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "PROBE_SESSION", "class_name": "ProbeSession" }]
  },
  "migrations": [{ "tag": "p1-probe-v1", "new_sqlite_classes": ["ProbeSession"] }],
  "observability": { "enabled": false }
}
