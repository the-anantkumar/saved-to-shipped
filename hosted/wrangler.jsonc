{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "save2ship-beta-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACES", "class_name": "WorkspacePrototype" }]
  },
  "migrations": [{ "tag": "p1", "new_sqlite_classes": ["WorkspacePrototype"] }],
  "observability": { "enabled": false }
}
