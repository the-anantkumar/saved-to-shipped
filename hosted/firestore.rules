// All collections contain private server-managed state: workspace records,
// encrypted provider credentials, membership, quotas, receipts and jobs.
// The trusted API validates Firebase identity, ownership and input invariants.
// Its database-scoped IAM service account is the only runtime data writer.
// Browser SDK and REST access is denied, including for signed-in owners, so
// clients cannot bypass admission, quotas or job reconciliation.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
